{
    "$schema": "https://getcomposer.org/schema.json",
    "name": "codingducksrl/laravel-queue-monitor",
    "description": "Queue monitoring for Laravel applications",
    "keywords": [
        "laravel",
        "codingducksrl",
        "queue",
        "monitor"
    ],
    "homepage": "https://github.com/codingducksrl/laravel-queue-monitor",
    "license": "MIT",
    "authors": [
        {
            "name": "Coding Duck s.r.l.",
            "email": "guglielmo.frati@codingduck.it",
            "role": "Developer"
        }
    ],
    "require": {
        "php": "^8.3",
        "illuminate/cache": "^13.0",
        "illuminate/console": "^13.0",
        "illuminate/contracts": "^13.0",
        "illuminate/queue": "^13.0",
        "illuminate/support": "^13.0"
    },
    "require-dev": {
        "larastan/larastan": "^3.9",
        "laravel/pint": "^1.30",
        "laravel/sail": "^1.67",
        "orchestra/testbench": "^10.0||^11.0",
        "pestphp/pest": "^4.6||^5.0",
        "pestphp/pest-plugin-laravel": "^4.1||^5.0",
        "pestphp/pest-plugin-type-coverage": "^4.0||^5.0",
        "phpstan/extension-installer": "^1.4"
    },
    "autoload": {
        "psr-4": {
            "CodingDuck\\QueueMonitor\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "CodingDuck\\QueueMonitor\\Tests\\": "tests/",
            "Workbench\\App\\": "workbench/app/",
            "Workbench\\Database\\Factories\\": "workbench/database/factories/",
            "Workbench\\Database\\Seeders\\": "workbench/database/seeders/"
        }
    },
    "scripts": {
        "post-autoload-dump": [
            "@clear",
            "@prepare"
        ],
        "prepare": [
            "@php vendor/bin/testbench package:discover --ansi"
        ],
        "build": [
            "@php vendor/bin/testbench workbench:build --ansi"
        ],
        "serve": [
            "Composer\\Config::disableProcessTimeout",
            "@build",
            "@php vendor/bin/testbench serve --ansi"
        ],
        "lint": [
            "vendor/bin/pint --parallel"
        ],
        "lint:check": [
            "vendor/bin/pint --parallel --test"
        ],
        "analyse": [
            "@php -d memory_limit=1G vendor/bin/phpstan analyse"
        ],
        "test:types": [
            "@php -d memory_limit=1G vendor/bin/pest --type-coverage --min=100"
        ],
        "test:unit": [
            "vendor/bin/pest --parallel"
        ],
        "test": [
            "@analyse",
            "@lint:check",
            "@test:types",
            "@test:unit"
        ],
        "clear": [
            "@php vendor/bin/testbench package:purge-skeleton --ansi"
        ]
    },
    "extra": {
        "laravel": {
            "providers": [
                "CodingDuck\\QueueMonitor\\QueueMonitorServiceProvider"
            ],
            "aliases": {
                "QueueMonitor": "CodingDuck\\QueueMonitor\\Facades\\QueueMonitor"
            }
        }
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "phpstan/extension-installer": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
